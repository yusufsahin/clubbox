{
  "name": "clubbox",
  "productName": "Clubbox",
  "description": "Unofficial desktop studio for Clubhouse",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-clip-worklet.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:preview": "electron .",
    "api:record": "node scripts/api-record.mjs",
    "api:docs": "node scripts/api-docs.mjs",
    "test:redact": "node --test electron/redact.test.cjs electron/apiRecorderFailure.test.cjs electron/ipcGuard.test.cjs && node --experimental-strip-types --test tests/capabilities.test.ts tests/guards.test.ts",
    "lint": "eslint .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "app.clubbox.desktop",
    "productName": "Clubbox",
    "copyright": "Unofficial desktop studio. Not affiliated with Clubhouse.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "!electron/apiRecorder.cjs",
      "!electron/redact.cjs",
      "!scripts/**",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Clubbox",
      "artifactName": "Clubbox-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Clubbox-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "Clubbox-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yusufsahin",
        "repo": "clubbox"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "agora-rtc-sdk-ng": "^4.24.8",
    "electron-updater": "^6.8.9"
  }
}
