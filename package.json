{
  "name": "clubbox",
  "productName": "Clubbox",
  "description": "Unofficial desktop studio for Clubhouse",
  "author": "Clubbox",
  "private": true,
  "version": "2.4.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-clip-worklet.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && node scripts/run-electron.mjs .",
    "desktop:preview": "node scripts/run-electron.mjs .",
    "api:record": "node scripts/api-record.mjs",
    "api:docs": "node scripts/api-docs.mjs",
    "api:check": "node scripts/api-docs.mjs --check",
    "api:sync-methods": "node scripts/sync-web-client-methods.mjs",
    "api:triage": "node scripts/api-triage.mjs",
    "api:discover": "node scripts/api-discover.mjs",
    "test:unit": "node --test electron/redact.test.cjs electron/apiRecorderFailure.test.cjs electron/ipcGuard.test.cjs electron/bundleScan.test.cjs electron/bundleCrawler.test.cjs electron/pubnubClient.test.cjs electron/apiLog.test.cjs electron/apiTriage.test.cjs electron/webSessionSignals.test.cjs && node --import tsx --test tests/*.test.ts tests/live-failures/*.test.ts",
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"not @pending\"",
    "test:trace": "node scripts/trace.mjs",
    "test:e2e": "npm run build && playwright test --grep-invert win-unpacked",
    "test:e2e:packaged": "npm run dist:dir && playwright test -g \"win-unpacked\"",
    "test:nocheck": "node scripts/check-nocheck.mjs",
    "test:theme-audit": "node scripts/theme-audit.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test": "npm run test:nocheck && npm run test:theme-audit && npm run test:unit && npm run test:bdd && npm run test:trace",
    "test:redact": "npm run test:unit",
    "lint": "eslint . && npm run api:check",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "app.clubbox.desktop",
    "productName": "Clubbox",
    "copyright": "Unofficial desktop studio. Not affiliated with Clubhouse.",
    "directories": {
      "output": "../clubdeck-app/release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "!electron/apiRecorder.cjs",
      "!scripts/**",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Clubbox",
      "artifactName": "Clubbox-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Clubbox-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "Clubbox-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "axe-core": "^4.14.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "agora-rtc-sdk-ng": "^4.24.8"
  }
}
